# Copy to .env.local for local development. Never commit real values.

# Public URL of the site (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery: "console" logs to the terminal (dev), "ses" sends via AWS SES.
# In production without MAILER=ses the contact section falls back to a mailto link.
MAILER=console
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# AWS (only when MAILER=ses). On Vercel, credentials come from Vercel OIDC -> this IAM role.
AWS_REGION=eu-central-1
AWS_ROLE_ARN=

# Cloudflare Turnstile. These are Cloudflare's official always-pass TEST keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
